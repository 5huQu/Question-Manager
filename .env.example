# Local OCR provider configuration.
# Copy this file to your app's local OCR settings screen or to a private env file.

OCR_API_BASE_URL=https://api.example.com/v1
OCR_API_KEY=
OCR_MODEL=

# Select `doc2x` for whole-PDF Doc2X v3 recognition, or `glm` for GLM-OCR.
OCR_PROVIDER=doc2x
DOC2X_API_BASE_URL=https://v2.doc2x.noedgeai.com
DOC2X_API_KEY=
DOC2X_MODEL=v3-2026

GLM_OCR_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4/layout_parsing
GLM_OCR_API_KEY=
GLM_OCR_MODEL=glm-ocr

# Optional AI assistant model for single-question cleanup and classification. Falls back to the OCR settings above when omitted.
OCR_CLEANUP_API_BASE_URL=
OCR_CLEANUP_API_KEY=
OCR_CLEANUP_MODEL=

# Optional local tool paths.
PYTHON_PATH=
XELATEX_PATH=
DVISVGM_PATH=

# PDF preview compilation. The SQLite-backed queue is shared by server
# processes that use the same QUESTION_DATA_DIR.
LAYOUT_PREVIEW_CONCURRENCY=1
LAYOUT_PREVIEW_POLL_MS=750
LAYOUT_PREVIEW_LEASE_MS=600000
LAYOUT_PREVIEW_CACHE_MAX_ENTRIES=50

# Optional data roots for source development.
QUESTION_DATA_DIR=
SOURCE_DOCUMENT_UPLOAD_MAX_BYTES=104857600
CANDIDATE_FIGURE_UPLOAD_MAX_BYTES=10485760
DOC2X_PACKAGE_UPLOAD_MAX_BYTES=209715200
UPLOAD_MAX_FIELDS=32
QUESTION_PYTHON_DATA_DIR=

# ─── Single-admin authentication ─────────────────────────────────────────────
# QUESTION_AUTH_MODE=single-admin   (default) force login for all APIs/files/pages
# QUESTION_AUTH_MODE=trusted-desktop (packaged Electron app; auto-authenticated)
# QUESTION_AUTH_MODE=disabled        (local development only; no login)
# PUBLIC_ORIGIN=https://question.example.com   fixed CSRF origin for cloud deploys
# AUTH_TRUSTED_PROXY=off              ignore client-supplied X-Forwarded-For by default
# AUTH_TRUSTED_PROXY=loopback         trust a local reverse proxy (Nginx/Caddy)
# AUTH_TRUSTED_PROXY=10.0.0.2,10.0.0.0/24  trust only these proxy addresses
# AUTH_COOKIE_SECURE=true            force Secure cookie (auto when PUBLIC_ORIGIN is https)
# AUTH_SESSION_DAYS=7                session lifetime in days
# ADMIN_BOOTSTRAP_TOKEN=             optional secret enabling the /admin-setup web flow
# AUTH_SCRYPT_CONCURRENCY=2          max concurrent scrypt verifications (1-2)
